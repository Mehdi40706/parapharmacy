{"file":"index-C55b3-xD.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AA6D8C,mBAAA;AAE9C,UAAM,SAAS,IAAa,EAAE;AAC9B,UAAM,eAAe,IAAwB,MAAS;AAEtD,UAAM,gBAAgB;AAAA,MACpB,EAAE,OAAO,UAAU,OAAO,OAAA;AAAA,MAC1B,EAAE,OAAO,cAAc,OAAO,UAAA;AAAA,MAC9B,EAAE,OAAO,cAAc,OAAO,YAAA;AAAA,MAC9B,EAAE,OAAO,aAAa,OAAO,UAAA;AAAA,MAC7B,EAAE,OAAO,WAAW,OAAO,YAAA;AAAA,MAC3B,EAAE,OAAO,YAAY,OAAO,YAAA;AAAA,IAAY;;;;AAlEtBA,oBAAA,gBAAL,MAAC;gDAIAC,MAAA,YAAA,MAAiB,EAAE,QAAK,uBAAA,uBAAA,YAAA,CAAA,CAAA,KAE7BC,eAAA,EAAE,KAAK,CAAA,WAAA;AAAA;;AAiBYF,oBAAAC,MAAA,MAAA,GAAA,CAAT,UAAK;AACM,cAAA,oDAAAC,eAAA,MAAc,MAAM,SAAS,CAAA,IAAAA,eAAQ,MAAc,MAAM,QAAQ,CAAA,oCAAAA,eACtD,MAAM,MAAM,MAAM,CAAA,yCAAAA,eACxB,MAAM,WAAW,QAAO,CAAA,CAAA,CAAA,2BAAA;;UACd,QAAQ,MAAM;AAAA,QAAA,GAAA,MAAA,OAAA,CAAA;kDACdA,eAAA,IAAA,KAAK,MAAM,SAAS,EAAE,mBAAkB,OAAA,CAAA,CAAA,+BAAAC,cAGtE,SAAO,MAAM,MAAM,CAAA,4TAAA;AAAA;;;;;;;;;;;","names":["_ssrRenderList","_unref","_ssrInterpolate","_ssrRenderAttr"],"sources":["../../../../../../../app/pages/admin/commandes/index.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h1 class=\"text-2xl font-semibold mb-6\">Commandes</h1>\r\n\r\n    <div class=\"flex gap-2 mb-6\">\r\n      <button\r\n        v-for=\"s in statusFilters\"\r\n        :key=\"s.value\"\r\n        @click=\"setFilter(s.value)\"\r\n        class=\"badge-pill\"\r\n        :class=\"activeFilter === s.value ? 'bg-sage text-white' : 'bg-mist text-ink/70'\"\r\n      >\r\n        {{ s.label }}\r\n      </button>\r\n    </div>\r\n\r\n    <div class=\"bg-white rounded-2xl border border-mist overflow-hidden\">\r\n      <table class=\"w-full text-sm\">\r\n        <thead class=\"bg-mist/50\">\r\n          <tr class=\"text-left\">\r\n            <th class=\"p-4\">Client</th>\r\n            <th class=\"p-4\">Articles</th>\r\n            <th class=\"p-4\">Total</th>\r\n            <th class=\"p-4\">Statut</th>\r\n            <th class=\"p-4\">Date</th>\r\n            <th class=\"p-4\"></th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"order in orders\" :key=\"order.id\" class=\"border-t border-mist\">\r\n            <td class=\"p-4\">{{ (order as any).user?.firstName }} {{ (order as any).user?.lastName }}</td>\r\n            <td class=\"p-4 text-ink/60\">{{ order.items.length }} article(s)</td>\r\n            <td class=\"p-4 price\">{{ order.totalPrice.toFixed(2) }} TND</td>\r\n            <td class=\"p-4\"><OrderStatusBadge :status=\"order.status\" /></td>\r\n            <td class=\"p-4 text-ink/60\">{{ new Date(order.createdAt).toLocaleDateString('fr-FR') }}</td>\r\n            <td class=\"p-4\">\r\n              <select\r\n                :value=\"order.status\"\r\n                @change=\"handleStatusChange(order.id, ($event.target as HTMLSelectElement).value)\"\r\n                class=\"input-field text-xs py-1\"\r\n              >\r\n                <option value=\"PENDING\">En attente</option>\r\n                <option value=\"CONFIRMED\">Confirmée</option>\r\n                <option value=\"PROCESSING\">En préparation</option>\r\n                <option value=\"SHIPPED\">Expédiée</option>\r\n                <option value=\"DELIVERED\">Livrée</option>\r\n                <option value=\"CANCELLED\">Annulée</option>\r\n              </select>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\ndefinePageMeta({ layout: 'admin', middleware: 'admin' });\r\n\r\nimport type { Order } from '~/types/order';\r\n\r\nconst { fetchAllOrders, updateOrderStatus } = useAdminOrders();\r\n\r\nconst orders = ref<Order[]>([]);\r\nconst activeFilter = ref<string | undefined>(undefined);\r\n\r\nconst statusFilters = [\r\n  { label: 'Toutes', value: undefined },\r\n  { label: 'En attente', value: 'PENDING' },\r\n  { label: 'Confirmées', value: 'CONFIRMED' },\r\n  { label: 'Expédiées', value: 'SHIPPED' },\r\n  { label: 'Livrées', value: 'DELIVERED' },\r\n  { label: 'Annulées', value: 'CANCELLED' },\r\n];\r\n\r\nconst load = async () => {\r\n  const result = await fetchAllOrders({ status: activeFilter.value });\r\n  orders.value = result.data;\r\n};\r\n\r\nconst setFilter = (value: string | undefined) => {\r\n  activeFilter.value = value;\r\n  load();\r\n};\r\n\r\nconst handleStatusChange = async (orderId: string, status: string) => {\r\n  await updateOrderStatus(orderId, status);\r\n  await load();\r\n};\r\n\r\nonMounted(load);\r\n</script>"],"version":3}