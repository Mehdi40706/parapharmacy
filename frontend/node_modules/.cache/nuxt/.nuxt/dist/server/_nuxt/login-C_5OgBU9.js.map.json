{"file":"login-C_5OgBU9.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AAmDkB,iBAAA;AACH,cAAA;AAEf,UAAM,OAAO,SAAS,EAAE,OAAO,IAAI,UAAU,IAAI;AACjD,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,eAAe,IAAI,EAAE;;;+RA/CRA,cAAA,SAAAC,MAAA,IAAA,EAAK,KAAK,CAAA,kKAWVD,cAAA,SAAAC,MAAA,IAAA,EAAK,QAAQ,CAAA,6EAAA;AAQjB,UAAAA,MAAA,YAAA,GAAY;6FAChBA,MAAA,YAAA,CAAY,CAAA,MAAA;AAAA,MAAA,OAAA;;;0DAGgBA,MAAA,OAAA,CAAO,IAAA,cAAA,8CACnCA,MAAA,OAAA,IAAO,iBAAA,cAAA,CAAA,0DAAA;;QAIA,IAAG;AAAA,QAAwB,OAAM;AAAA,MAAA,GAAA;AAAA,yBAA3C,CAEW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAF4D,yBAEvE;AAAA,YAAA;AAAA;;;;;QACU,IAAG;AAAA,QAAiB,OAAM;AAAA,MAAA,GAAA;AAAA,yBAApC,CAEW,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAFiE,mBAE5E;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttr","_unref","_push","_parent"],"sources":["../../../../../../../app/pages/auth/login.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h1 class=\"text-2xl font-semibold mb-1\">Content de vous revoir</h1>\r\n    <p class=\"text-ink/60 text-sm mb-6\">Connectez-vous à votre compte</p>\r\n\r\n    <form @submit.prevent=\"handleLogin\" class=\"flex flex-col gap-4\">\r\n      <div>\r\n        <label class=\"block text-sm font-medium mb-1.5\">Email</label>\r\n        <input\r\n          v-model=\"form.email\"\r\n          type=\"email\"\r\n          required\r\n          class=\"input-field\"\r\n          placeholder=\"vous@exemple.com\"\r\n        />\r\n      </div>\r\n\r\n      <div>\r\n        <label class=\"block text-sm font-medium mb-1.5\">Mot de passe</label>\r\n        <input\r\n          v-model=\"form.password\"\r\n          type=\"password\"\r\n          required\r\n          class=\"input-field\"\r\n          placeholder=\"••••••••\"\r\n        />\r\n      </div>\r\n\r\n      <p v-if=\"errorMessage\" class=\"text-clay text-sm bg-clay/10 rounded-lg px-3 py-2\">\r\n        {{ errorMessage }}\r\n      </p>\r\n\r\n      <button type=\"submit\" :disabled=\"loading\" class=\"btn-primary mt-2\">\r\n        {{ loading ? 'Connexion...' : 'Se connecter' }}\r\n      </button>\r\n\r\n      <div class=\"flex justify-between text-sm pt-2\">\r\n        <NuxtLink to=\"/auth/forgot-password\" class=\"text-sage hover:underline\">\r\n          Mot de passe oublié ?\r\n        </NuxtLink>\r\n        <NuxtLink to=\"/auth/register\" class=\"text-sage hover:underline font-medium\">\r\n          Créer un compte\r\n        </NuxtLink>\r\n      </div>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\ndefinePageMeta({ layout: 'auth', middleware: 'guest' });\r\n\r\nconst authStore = useAuthStore();\r\nconst router = useRouter();\r\n\r\nconst form = reactive({ email: '', password: '' });\r\nconst loading = ref(false);\r\nconst errorMessage = ref('');\r\n\r\nconst handleLogin = async () => {\r\n  loading.value = true;\r\n  errorMessage.value = '';\r\n  try {\r\n    await authStore.login(form.email, form.password);\r\n    router.push('/');\r\n  } catch (error: any) {\r\n    errorMessage.value = error?.data?.message || 'Email ou mot de passe incorrect';\r\n  } finally {\r\n    loading.value = false;\r\n  }\r\n};\r\n</script>"],"version":3}