{"file":"index-DuvbGbuj.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;AA4D0B,gBAAA;AACA,qBAAA;AAE1B,UAAM,WAAW,IAAe,EAAE;AAClC,UAAM,aAAa,IAAS,IAAI;AAChC,UAAM,cAAc,IAAI,CAAC;;;;;QA7DT,IAAG;AAAA,QAA0B,OAAM;AAAA,MAAA,GAAA;AAAA,yBAA7C,CAAuF,GAAAA,QAAAC,UAAA,aAAA;;;;;8BAA5B,mBAAiB;AAAA,YAAA;AAAA;;;;;AAelDC,oBAAAC,MAAA,QAAA,GAAA,CAAX,YAAO;8EACeC,eAAA,QAAQ,IAAI,CAAA,oCAAAA,eACZ,QAAQ,SAAS,IAAI,CAAA,8BAAAA,eAC3B,QAAQ,MAAM,QAAO,CAAA,CAAA,CAAA,yCAE9BC,eAAA,QAAQ,UAAK,IAAA,cAAA,aAAA,CAAA,KACtBD,eAAA,QAAQ,KAAK,CAAA,yCAAA;;UAIP,IAAE,mBAAqB,QAAQ,EAAE;AAAA,UAAS,OAAM;AAAA,QAAA,GAAA;AAAA,2BAA3D,CAEW,GAAAJ,QAAAC,UAAA,aAAA;;;;;gCAFiF,YAE5F;AAAA,cAAA;AAAA;;;;;;;AAUC,UAAAE,MAAA,UAAA,KAAcA,MAAA,UAAA,EAAW,aAAU,GAAA;;AAE3BD,sBAAAC,MAAA,UAAA,EAAW,YAAU,CAA7B,SAAI;kCAIHE,eAAA,CAAA,SAASF,MAAA,WAAA,IAAW,uBAAA,iBAAA,0CAAA,CAAA,CAAA,KAAAC,eAEzB,IAAI,CAAA,WAAA;AAAA;;;;;;;;;;;;;;;","names":["_push","_parent","_ssrRenderList","_unref","_ssrInterpolate","_ssrRenderClass"],"sources":["../../../../../../../app/pages/admin/produits/index.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"flex justify-between items-center mb-6\">\r\n      <h1 class=\"text-2xl font-semibold\">Produits</h1>\r\n      <NuxtLink to=\"/admin/produits/nouveau\" class=\"btn-primary\">+ Nouveau produit</NuxtLink>\r\n    </div>\r\n\r\n    <div class=\"bg-white rounded-2xl border border-mist overflow-hidden\">\r\n      <table class=\"w-full text-sm\">\r\n        <thead class=\"bg-mist/50\">\r\n          <tr class=\"text-left\">\r\n            <th class=\"p-4\">Nom</th>\r\n            <th class=\"p-4\">Catégorie</th>\r\n            <th class=\"p-4\">Prix</th>\r\n            <th class=\"p-4\">Stock</th>\r\n            <th class=\"p-4\"></th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"product in products\" :key=\"product.id\" class=\"border-t border-mist\">\r\n            <td class=\"p-4 font-medium\">{{ product.name }}</td>\r\n            <td class=\"p-4 text-ink/60\">{{ product.category.name }}</td>\r\n            <td class=\"p-4 price\">{{ product.price.toFixed(2) }} TND</td>\r\n            <td class=\"p-4\">\r\n              <span :class=\"product.stock === 0 ? 'text-clay' : 'text-ink/70'\">\r\n                {{ product.stock }}\r\n              </span>\r\n            </td>\r\n            <td class=\"p-4 text-right\">\r\n              <NuxtLink :to=\"`/admin/produits/${product.id}/edit`\" class=\"text-sage hover:underline mr-3\">\r\n                Modifier\r\n              </NuxtLink>\r\n              <button @click=\"handleDelete(product.id)\" class=\"text-clay hover:underline\">\r\n                Supprimer\r\n              </button>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div v-if=\"pagination && pagination.totalPages > 1\" class=\"flex justify-center gap-2 mt-6\">\r\n      <button\r\n        v-for=\"page in pagination.totalPages\"\r\n        :key=\"page\"\r\n        @click=\"goToPage(page)\"\r\n        class=\"w-9 h-9 rounded-pill text-sm font-medium\"\r\n        :class=\"page === currentPage ? 'bg-sage text-white' : 'hover:bg-mist'\"\r\n      >\r\n        {{ page }}\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\ndefinePageMeta({ layout: 'admin', middleware: 'admin' });\r\n\r\nimport type { Product } from '~/types/product';\r\n\r\nconst { fetchProducts } = useProducts();\r\nconst { deleteProduct } = useAdminProducts();\r\n\r\nconst products = ref<Product[]>([]);\r\nconst pagination = ref<any>(null);\r\nconst currentPage = ref(1);\r\n\r\nconst load = async () => {\r\n  const result = await fetchProducts({ page: currentPage.value, limit: 10 });\r\n  products.value = result.data;\r\n  pagination.value = result.meta;\r\n};\r\n\r\nconst goToPage = (page: number) => {\r\n  currentPage.value = page;\r\n  load();\r\n};\r\n\r\nconst handleDelete = async (id: string) => {\r\n  if (!confirm('Supprimer ce produit ?')) return;\r\n  await deleteProduct(id);\r\n  await load();\r\n};\r\n\r\nonMounted(load);\r\n</script>"],"version":3}